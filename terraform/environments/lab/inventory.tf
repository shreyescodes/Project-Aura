# Terraform owns the addressing plan, so it also writes the Ansible inventory.
# The generated file is gitignored and recreated on every apply.
locals {
  inventory_hosts = {
    for group, nodes in {
      controllers = module.controllers.nodes
      computes    = module.computes.nodes
      ceph        = module.ceph.nodes
      } : group => {
      hosts = {
        for hostname, node in nodes : hostname => {
          ansible_host   = node.addresses.mgmt
          aura_addresses = node.addresses
        }
      }
    }
  }

  inventory = {
    all = {
      vars = {
        ansible_user      = var.admin_user
        aura_dns_domain   = var.dns_domain
        aura_internal_vip = cidrhost(module.networking.networks.mgmt.cidr, var.internal_vip_host_number)
        aura_networks = {
          for name, network in module.networking.networks : name => {
            cidr    = network.cidr
            gateway = network.gateway
            mtu     = network.mtu
          }
        }
      }
      children = local.inventory_hosts
    }
  }
}

resource "local_file" "ansible_inventory" {
  filename        = "${path.module}/../../../ansible/inventories/lab/hosts.yml"
  file_permission = "0644"
  content         = "# Generated by terraform/environments/lab. Do not edit.\n${yamlencode(local.inventory)}"
}
