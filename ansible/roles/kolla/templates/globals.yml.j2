---
# {{ ansible_managed }}
# Only settings that differ from Kolla-Ansible's defaults are listed.

kolla_base_distro: "ubuntu"
openstack_release: "{{ kolla_openstack_release }}"

# --- Networking ---------------------------------------------------------------
# Interface names are set by cloud-init (see terraform/modules/node-group).
network_interface: "mgmt"
tunnel_interface: "tunnel"
storage_interface: "storage"
neutron_external_interface: "external"

kolla_internal_vip_address: "{{ kolla_internal_vip_address }}"
keepalived_virtual_router_id: "{{ kolla_keepalived_virtual_router_id }}"
enable_haproxy: "yes"

neutron_plugin_agent: "ovn"
enable_neutron_provider_networks: "yes"
# Floating IP traffic leaves from the compute node hosting the VM instead of
# hairpinning through a controller.
neutron_ovn_distributed_fip: "yes"

# /etc/hosts is managed by the common role for every node, including Ceph.
customize_etc_hosts: false

# --- Compute ------------------------------------------------------------------
nova_compute_virt_type: "kvm"

# --- Storage (external Ceph, deployed by cephadm) -----------------------------
enable_cinder: "yes"
enable_cinder_backup: "no"
glance_backend_ceph: "yes"
cinder_backend_ceph: "yes"
nova_backend_ceph: "yes"
ceph_glance_user: "glance"
ceph_cinder_user: "cinder"
ceph_nova_user: "cinder"

# --- Monitoring ---------------------------------------------------------------
enable_prometheus: "yes"
enable_grafana: "yes"
enable_prometheus_alertmanager: "yes"
enable_prometheus_openstack_exporter: "yes"
enable_prometheus_ceph_mgr_exporter: "yes"
prometheus_ceph_mgr_exporter_endpoints:
{% for host in groups['ceph'] %}
  - "{{ hostvars[host]['aura_addresses']['storage'] }}:{{ kolla_ceph_mgr_exporter_port }}"
{% endfor %}
