# {{ ansible_managed }}
# Role groups are generated from the Aura inventory; the service group mapping
# below them is copied from Kolla-Ansible {{ kolla_openstack_release }}.

[control]
{% for host in kolla_control_hosts %}
{{ host }} ansible_host={{ hostvars[host]['aura_addresses']['mgmt'] }}
{% endfor %}

[network:children]
control

[storage:children]
control

[monitoring:children]
control

[compute]
{% for host in kolla_compute_hosts %}
{{ host }} ansible_host={{ hostvars[host]['aura_addresses']['mgmt'] }}
{% endfor %}

[deployment]
# Deployment-host tasks need the virtualenv's Python and its libraries.
localhost ansible_connection=local ansible_python_interpreter={{ kolla_venv }}/bin/python3

[all:vars]
ansible_user={{ ansible_user }}
ansible_become=true
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_private_key_file={{ kolla_ssh_key_path }}

[baremetal:children]
{{ (kolla_upstream_inventory['content'] | b64decode).split('[baremetal:children]', 1)[1] | trim }}
