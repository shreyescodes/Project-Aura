# Copy to .env for local runs. Every setting is read from AURA_* variables.

# JSON list; list two keys during a rotation.
AURA_API_KEYS=["change-me"]

# clouds.yaml entry with admin credentials (Kolla writes /etc/kolla/clouds.yaml).
AURA_OS_CLOUD=kolla-admin

AURA_DOMAIN_ID=default
AURA_EXTERNAL_NETWORK=public
AURA_DNS_NAMESERVERS=["1.1.1.1", "9.9.9.9"]
AURA_MEMBER_ROLE=member
AURA_LOG_LEVEL=INFO
